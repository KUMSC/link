{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link",
  "compatibility_date": "2026-08-22",
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "link-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "link-uploads"
    }
  ]
  // Optional KV caching: KV namespaces are NOT auto-provisioned (unlike D1/R2).
  // To enable, run:  npx wrangler kv namespace create CACHE
  // then add:        "kv_namespaces": [{ "binding": "CACHE", "id": "<the id>" }]
}